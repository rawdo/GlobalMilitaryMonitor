<Window x:Class="GlobalMilitaryMonitor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        xmlns:converters="clr-namespace:GlobalMilitaryMonitor.UI.Converters"
        Title="Global Military Monitor - Real-Time Geopolitical Dashboard"
        Height="900" Width="1500"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:SeverityToColorConverter x:Key="SeverityToColor" />
        <converters:CategoryToIconConverter x:Key="CategoryToIcon" />
        <converters:TimestampToRelativeConverter x:Key="TimestampToRelative" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:SeverityToBorderConverter x:Key="SeverityToBorder" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F30D;" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="GLOBAL MILITARY MONITOR" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  |  Real-Time Geopolitical Dashboard" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4"
                            Padding="12,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Events: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TotalEvents}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4"
                            Padding="12,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Alerts: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ActiveAlerts}" Foreground="{StaticResource AlertRedBrush}"
                                       FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4"
                            Padding="12,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hotspots: " Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding ConflictZoneCount}" Foreground="{StaticResource WarningOrangeBrush}"
                                       FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4"
                            Padding="12,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Military Aircraft: " Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" />
                            <TextBlock Text="{Binding TrackedAssets}" Foreground="{StaticResource SuccessGreenBrush}"
                                       FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last Update: " Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastUpdateText}" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="&#x21BB; Refresh" Command="{Binding RefreshCommand}" Padding="12,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Map + Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Map Area -->
            <Border Grid.Column="0" Background="{StaticResource PrimaryBackgroundBrush}" Margin="4">
                <Grid>
                    <!-- GMap.NET Map Control -->
                    <gmap:GMapControl x:Name="MainMap" />

                    <!-- Loading Overlay -->
                    <Border Background="#80000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Loading data feeds..." FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Map Legend -->
                    <Border Background="#CC1A1A2E" CornerRadius="6" Padding="10"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LEGEND" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Fill="#D50000" Margin="0,0,6,0" />
                                <TextBlock Text="Critical" FontSize="10" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Fill="#F44336" Margin="0,0,6,0" />
                                <TextBlock Text="High Severity" FontSize="10"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Fill="#FF9800" Margin="0,0,6,0" />
                                <TextBlock Text="Medium" FontSize="10" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,6,0" />
                                <TextBlock Text="Low" FontSize="10" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Rectangle Width="10" Height="10" Fill="#0096FF" RadiusX="2" RadiusY="2"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Military aircraft (live)" FontSize="10"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Fill="#D5000060" Stroke="#D50000" StrokeThickness="1"
                                         Margin="0,0,6,0" />
                                <TextBlock Text="Hotspot (live reports)" FontSize="10"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Right Sidebar: Events + Alerts -->
            <Border Grid.Column="2" Background="{StaticResource SecondaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Alerts Section -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            MaxHeight="250">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="12,8"
                                    Background="#40D50000">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A0;" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="ACTIVE ALERTS" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource AlertRedBrush}" />
                                    <TextBlock Text="{Binding ActiveAlerts, StringFormat=' ({0})'}" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Alerts}"
                                     SelectedItem="{Binding SelectedEvent}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="2"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBorder}}"
                                                CornerRadius="4"
                                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                BorderThickness="0,0,3,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                                           FontSize="16" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding Country}" FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Timestamp, Converter={StaticResource TimestampToRelative}}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Search / Filter -->
                    <Border Grid.Row="1" Padding="8" Background="{StaticResource SecondaryBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="LIVE EVENT FEED" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" Margin="4,0,0,6" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search events..." Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox Content="Alerts Only" IsChecked="{Binding AlertsOnly}"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}"
                                        Padding="8,2" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Events List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredEvents}"
                             SelectedItem="{Binding SelectedEvent}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="2" CornerRadius="4"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorder}}"
                                        BorderThickness="0,0,3,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                   Text="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                                   FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="1" Grid.Row="0"
                                                   Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />

                                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock FontSize="9"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                       Margin="0,0,6,0">
                                                <TextBlock.Text>
                                                    <Binding Path="Severity" StringFormat="[{0}]" />
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Country}" FontSize="9"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Source}" FontSize="9"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                                   Text="{Binding Timestamp, Converter={StaticResource TimestampToRelative}}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter between map and bottom panel -->
        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext" />

        <!-- Bottom Panel: Timeline -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,6"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F552;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="EVENT TIMELINE" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="  |  Chronological incident log" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding TimelineEvents}"
                         SelectedItem="{Binding SelectedEvent}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Padding="8" Margin="4" CornerRadius="6"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorder}}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                                   FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock FontSize="9"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                            <TextBlock.Text>
                                                <Binding Path="Severity" StringFormat="[{0}]" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="36"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Country}" FontSize="9"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampToRelative}}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Source}" FontSize="8"
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource CardBackgroundBrush}"
                Padding="12,4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding SourceSummary}" FontSize="10"
                               ToolTip="{Binding SourceDetails}" ToolTipService.ShowDuration="60000"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <TextBlock Text="{Binding LastUpdate, StringFormat='UTC: {0:yyyy-MM-dd HH:mm:ss}'}"
                               FontSize="10"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
